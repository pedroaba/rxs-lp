{
  "name": "rsx-landing-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.tsx",
    "build:production": "tsx scripts/production.ts",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "playwright test",
    "media": "tsx scripts/media.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "tsx scripts/screenshots.ts",
    "lighthouse": "lighthouse http://127.0.0.1:4173 --output html --output json --output-path output/qa/lighthouse --chrome-flags='--headless --no-sandbox' --only-categories=performance,accessibility,best-practices,seo"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.8",
    "lighthouse": "13.5.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  }
}
